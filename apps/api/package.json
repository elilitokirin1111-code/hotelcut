    "@hotelcut/database": "workspace:*",
    "@hotelcut/domain": "workspace:*",
    "@hotelcut/job-queue": "workspace:*",
    "@hotelcut/media": "workspace:*",
    "@hotelcut/schemas": "workspace:*",
    "@hotelcut/storage": "workspace:*",
    "@hotelcut/templates": "workspace:*",
    "@hotelcut/timeline": "workspace:*",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^7.0.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
