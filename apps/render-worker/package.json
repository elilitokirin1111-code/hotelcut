    "@hotelcut/renderer": "workspace:*",
    "@hotelcut/schemas": "workspace:*",
    "@hotelcut/storage": "workspace:*",
    "@hotelcut/timeline": "workspace:*",
    "bullmq": "^5.58.5",
    "ioredis": "^5.7.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
