NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
RENDER_WORKER_HEALTH_PORT=3001
ANALYSIS_WORKER_PORT=8001

POSTGRES_DB=hotelcut
POSTGRES_USER=hotelcut
POSTGRES_PASSWORD=hotelcut_local
DATABASE_URL=postgresql://hotelcut:hotelcut_local@localhost:5432/hotelcut
SEED_DEVELOPMENT_DATA=true
DEVELOPMENT_SEED_PASSWORD=hotelcut-local
ALLOW_DEVELOPMENT_IDENTITY=true
AUTH_SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
# x-user-id remains a non-production integration-test compatibility path. Disable it to exercise
# only the server-owned email session boundary.

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hotelcut
S3_SECRET_ACCESS_KEY=hotelcut_local_secret
S3_BUCKET=hotelcut-local
MINIO_CONSOLE_PORT=9001
MINIO_API_CORS_ALLOW_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

ANALYSIS_TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
