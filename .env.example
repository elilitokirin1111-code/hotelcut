NODE_ENV=development
WEB_PORT=5173
API_PORT=3000
RENDER_WORKER_HEALTH_PORT=3001
ANALYSIS_WORKER_PORT=8001

POSTGRES_DB=hotelcut
POSTGRES_USER=hotelcut
POSTGRES_PASSWORD=hotelcut_local
DATABASE_URL=postgresql://hotelcut:hotelcut_local@localhost:5432/hotelcut
SEED_DEVELOPMENT_DATA=true
# M1 local development identity used in the x-user-id request header:
# 20000000-0000-4000-8000-000000000001

REDIS_URL=redis://localhost:6379

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=hotelcut
S3_SECRET_ACCESS_KEY=hotelcut_local_secret
S3_BUCKET=hotelcut-local
MINIO_CONSOLE_PORT=9001

ANALYSIS_TRANSCRIPTION_PROVIDER=mock
WHISPER_MODEL=tiny
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
