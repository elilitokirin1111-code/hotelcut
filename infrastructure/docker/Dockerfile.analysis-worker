FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg libgl1 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/analysis-worker/pyproject.toml ./
COPY apps/analysis-worker/src ./src

RUN python -m pip install --no-cache-dir --retries 8 --timeout 120 .

EXPOSE 8001

CMD ["python", "-m", "hotelcut_analysis_worker.main"]
