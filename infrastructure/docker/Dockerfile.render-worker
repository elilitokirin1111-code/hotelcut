FROM node:22-bookworm-slim AS build

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH
ENV npm_config_registry=https://registry.npmmirror.com

RUN corepack enable \
  && corepack prepare pnpm@11.9.0 --activate \
  && pnpm config set registry https://registry.npmmirror.com \
  && pnpm config set @remotion:registry https://registry.npmjs.org

WORKDIR /workspace

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages

RUN pnpm install --frozen-lockfile --filter "@hotelcut/render-worker..." --network-concurrency=4 --fetch-retries=5 --fetch-timeout=600000
RUN pnpm --filter "@hotelcut/render-worker"... build

FROM node:22-bookworm-slim AS runtime

RUN sed -i 's|http://deb.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g; s|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 update \
  && apt-get -o Acquire::Retries=5 -o Acquire::http::Timeout=30 install -y --no-install-recommends ca-certificates
RUN sed -i 's|http://mirrors.aliyun.com/debian-security|https://mirrors.cloud.tencent.com/debian-security|g; s|http://mirrors.aliyun.com/debian|https://mirrors.cloud.tencent.com/debian|g' /etc/apt/sources.list.d/debian.sources \
  && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 update \
  && apt-get -o Acquire::Retries=5 -o Acquire::https::Timeout=30 install -y --no-install-recommends chromium ffmpeg fonts-noto-cjk \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

COPY --from=build /workspace /workspace

ENV NODE_ENV=production
ENV REMOTION_BROWSER_EXECUTABLE=/usr/bin/chromium
ENV RENDER_TEMP_ROOT=/tmp/hotelcut-render

CMD ["node", "apps/render-worker/dist/main.js"]
